# Auto-injected by Tarrs into the dev sandbox. For local dev / Vercel
# prod, paste these from your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to client. Used in route handlers / server
# actions when you need to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — powers the evaluation runtime (lib/eval.ts). Without it,
# POST /v1/submissions/:id/evaluate returns a clean 502 and records the
# evaluation as errored. Add the real value in the Tarrs env-vars UI (secret),
# not here.
ANTHROPIC_API_KEY=
